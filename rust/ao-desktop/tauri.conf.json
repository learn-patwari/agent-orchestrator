{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Orchestrator",
  "version": "0.1.0",
  "identifier": "com.agentorchestrator.app",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend/out": "ui",
      "../../.development": "builtin",
      "../../plugins": "plugins"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
