{
  "name": "agent-orchestrator-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for the Agent Orchestrator (Electron around the FastAPI backend and Next.js UI)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.agentorchestrator.app",
    "productName": "Agent Orchestrator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/backend",
        "to": "backend"
      },
      {
        "from": "stage/ui",
        "to": "ui"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
